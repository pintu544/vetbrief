# Copy to .env and fill locally. Never commit .env. Never put a real key in this file's history.

# --- Web server (the live app URL surface) ---
# Port the server listens on (Render/Railway set this automatically).
PORT=3000
# Agent wallet private key — ENVIRONMENT ONLY, never committed, never logged.
# Used by the server in mainnet mode to derive the agent address. On the
# build VM the key lives in a 600-perms file instead (AGENT_KEY_FILE below);
# a deployed service should use its platform secret store.
AGENT_PRIVATE_KEY=
# Public agent wallet address (shown in sandbox mode, where the buy CLI
# holds the key in its own keystore and this process never sees it).
AGENT_WALLET_ADDRESS=
# Where brief receipts + the trial ledger are written.
RECEIPTS_DIR=receipts

# --- Telegram bot ---
# Telegram bot token from BotFather (Pintu-only step). Bot runs in mock mode without it.
TELEGRAM_BOT_TOKEN=
# Set to 1 to actually poll Telegram (explicit-start rule; nothing long-running starts by accident).
BOT_START=

# --- Wallet / buy CLI ---
# Path to the agent wallet private-key file (600 perms, outside the repo in production use).
AGENT_KEY_FILE=
# buy CLI account name created by `buy setup --import`.
BUY_ACCOUNT=vetbrief
# Mode: "sandbox" (Celo Sepolia, default rehearsal), "mainnet" (real money —
# server only enters it with AGENT_PRIVATE_KEY set), or "mock" (fixtures, $0).
BUY_MODE=sandbox
# Optional RPC overrides (the default Celo Sepolia Forno endpoint timed out
# from the build VM on 8 Nov 2026; a public alternative answered instantly).
CELO_RPC_URL=
CELO_SEPOLIA_RPC_URL=

# Feature flag: sanctions screen via buy gateway. Keep OFF until the route's
# availability + Celo settlement rail are verified (see spec Slice 0).
SANCTIONS_ENABLED=false
